{
  "name": "discord-hangout-space",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -n SERVER,CLIENT -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w server && npm run build -w client",
    "start": "NODE_ENV=production node server/dist/server/src/index.js",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "validate-world": "tsx scripts/validate-world.ts",
    "check-layout": "tsx scripts/validate-world.ts",
    "build-models": "tsx scripts/build-models.ts"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
